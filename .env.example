DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET_KEY=change-me
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=contact@example.com
# Add the extension's Chrome origin (derived from extension/manifest.json's
# fixed `key`) so its API calls aren't blocked by CORS. Firefox's
# moz-extension:// origin is a random per-install UUID and is instead
# allowed by scheme via allow_origin_regex in app/main.py — no entry needed
# here for Firefox.
# CORS_ORIGINS=http://localhost:5173,chrome-extension://<id-derived-from-manifest-key>
CORS_ORIGINS=http://localhost:5173
SITE_URL=http://localhost:5173

# Optional: creates this admin on first startup if no user with this email
# exists yet. Safe to leave set across restarts (no-ops once the user exists).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Garage/S3 storage for event images.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
